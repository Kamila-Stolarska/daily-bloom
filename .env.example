# Klucz do Groq (Whisper transcription). Pobierz: https://console.groq.com/keys
# NIE commituj prawdziwego klucza. Skopiuj ten plik jako `.env.local`.
GROQ_API_KEY=

# Klucz do xAI (Grok — agent czat). Pobierz: https://console.x.ai
# Server-side only (bez prefiksu EXPO_PUBLIC).
XAI_API_KEY=

# Baza URL backendu transkrypcji. Pusto = relative (działa na webie pod tą samą domeną).
# Na natywne (iOS/Android) ustaw pełny URL preview/produkcji Vercela:
# EXPO_PUBLIC_API_BASE=https://daily-bloom.vercel.app
EXPO_PUBLIC_API_BASE=

# Supabase — z dashboardu projektu (Settings → API).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Strapi CMS — publiczna baza URL (używana tylko do rozwiązywania URL-i mediów w kliencie).
# Lokalnie: http://localhost:1337. Produkcyjnie: https://<projekt>.up.railway.app
EXPO_PUBLIC_STRAPI_URL=

# Strapi CMS — server-side token (Vercel proxy: /api/posts + /api/v1/entries).
# NIE dawaj mu prefiksu EXPO_PUBLIC — inaczej wyleci do bundlu klienta.
STRAPI_URL=
STRAPI_TOKEN=

# CORS allowlist dla /api/transcribe (przecinkami, bez slasha na końcu).
# Pusto = tylko localhost + bieżący host Vercela (z VERCEL_URL).
# Przykład: ALLOWED_ORIGINS=https://daily-bloom.vercel.app,https://dailybloom.app
ALLOWED_ORIGINS=


# PostHog analytics (EU region). Pobierz Project API Key: https://eu.posthog.com → Settings → Project.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
